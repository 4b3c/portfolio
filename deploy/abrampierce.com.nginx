# /etc/nginx/sites-available/abrampierce.com, symlinked into sites-enabled.
# Plain HTTP to start; `certbot --nginx -d abrampierce.com -d www.abrampierce.com`
# adds the 443 block and the redirect.
server {
    listen 80;
    listen [::]:80;
    server_name abrampierce.com www.abrampierce.com;

    location / {
        proxy_pass http://127.0.0.1:8020;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
