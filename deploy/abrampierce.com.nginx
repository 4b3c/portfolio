# /etc/nginx/sites-available/abrampierce.com, symlinked into sites-enabled.
# abrampierce.com and every subdomain go to the one container; run.py picks the
# site from the Host header, and sends a subdomain with nothing on it to www.
# DNS is a proxied wildcard at Cloudflare, so Cloudflare holds the public
# certificate; the origin certificate here only has to cover the names below.
server {
    listen 80;
    listen [::]:80;
    server_name abrampierce.com *.abrampierce.com;

    location / {
        proxy_pass http://127.0.0.1:8020;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
