# /etc/nginx/sites-available/toggle.abrampierce.com, symlinked into sites-enabled.
# The shared toggle and tug-of-war, the toggle container on :5002. An exact name,
# so it wins over the wildcard vhost. The certificate is the apex one, as for the
# wildcard: Cloudflare holds the public certificate.
server {
    listen 80;
    listen [::]:80;
    server_name toggle.abrampierce.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name toggle.abrampierce.com;
    ssl_certificate /etc/letsencrypt/live/abrampierce.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/abrampierce.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:5002;
        proxy_http_version 1.1;

        # websockets
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # a socket stays open as long as the page does
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering    off;
    }
}
